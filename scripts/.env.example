# Copy to scripts/.env and fill in. scripts/.env is gitignored.
# See scripts/SEO_REPORT_SETUP.md for how to obtain these.

# Absolute path to the service-account JSON key you downloaded from Google Cloud.
GOOGLE_APPLICATION_CREDENTIALS=/Users/ryoooue/dev/rwjapanese/realworldjapanese/scripts/gsc-ga4-key.json

# Search Console property identifier.
#   Domain property (recommended):  sc-domain:realworldjapanese.com
#   URL-prefix property:            https://realworldjapanese.com/
GSC_SITE_URL=sc-domain:realworldjapanese.com

# GA4 numeric property id (Admin → Property Settings → "プロパティ ID").
GA4_PROPERTY_ID=000000000
