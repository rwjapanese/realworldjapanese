---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";
import { filterByLang, withLang, getLangStaticPaths } from "@/utils/i18n";
import type { LanguageCode } from "@/config/languages";

export async function getStaticPaths() {
  return getLangStaticPaths();
}

const { lang } = Astro.params as { lang: LanguageCode };

const allBlog = await getCollection("blog");
const allGuides = await getCollection("guides");
const allEntries = [...allBlog, ...allGuides];
const posts = filterByLang(allEntries, lang);
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);

const heroCopy = {
  en: {
    eyebrow: "Real phrases · Real workplaces",
    tagline: "Real phrases for real Japanese workplaces.",
    body: "Stop sounding rude at work. Our A/B/C politeness framework shows you the three versions of every phrase — and exactly when to use each one.",
    cta: "Get the free PDF",
    ctaNote: "Free · “Saying No” in 5 work situations",
    browse: "Browse the guides",
    vertical: "実践の日本語",
    allPosts: "All Posts",
    socials: "Social Links:",
  },
  ja: {
    eyebrow: "実践・ビジネス日本語",
    tagline: "日本のビジネス現場で本当に使われる言葉を。",
    body: "メールで「失礼な人」になっていませんか？ A/B/C の敬語フレームワークで、同じ意味の3パターンを使い分けられるようになります。",
    cta: "無料PDFを受け取る",
    ctaNote: "無料・職場の「断り方」5場面（英語解説）",
    browse: "記事を見る",
    vertical: "実践の日本語",
    allPosts: "記事一覧",
    socials: "ソーシャル:",
  },
};

const copy = heroCopy[lang as "en" | "ja"] ?? heroCopy.en;
const freeLpHref = "/free/?utm_source=site&utm_medium=hero";
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index">
    <!-- Editorial hero in the brand system (hinomaru circle, vertical-text
         accent, faint kanji watermark). Decorative shapes bleed off the
         viewport edge, so this section sits outside .app-layout and wraps
         its content in one instead. -->
    <section id="hero" class="relative overflow-clip border-b border-border">
      <div
        aria-hidden="true"
        class="absolute top-[-6rem] right-[-6rem] size-[12rem] rounded-full bg-brand-red sm:top-[-7rem] sm:right-[-7rem] sm:size-[24rem]"
      >
      </div>
      <p
        aria-hidden="true"
        class="absolute top-7 right-5 hidden text-sm font-semibold tracking-[0.3em] text-white/90 [writing-mode:vertical-rl] md:block"
      >
        {copy.vertical}
      </p>
      <p
        aria-hidden="true"
        class="pointer-events-none absolute top-0 left-2/3 -translate-x-1/2 text-[13rem] leading-none font-bold text-foreground/[0.04] select-none sm:text-[19rem]"
      >
        敬
      </p>

      <div class="app-layout relative z-10 pt-12 pb-12 sm:pt-16 sm:pb-14">
        <p
          class="mb-4 flex items-center gap-2 text-xs font-semibold tracking-[0.2em] text-accent uppercase"
        >
          <span aria-hidden="true" class="inline-block size-2 bg-brand-red"
          ></span>
          {copy.eyebrow}
        </p>
        <h1 class="max-w-xl text-4xl leading-tight font-bold sm:text-6xl">
          Real-World Japanese<span class="text-brand-red">.</span>
        </h1>
        <p class="mt-6 max-w-xl text-base leading-relaxed text-foreground/80">
          {copy.body}
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a
            href={freeLpHref}
            class="inline-flex items-center gap-3 rounded-sm bg-brand-red px-7 py-3 text-base font-semibold text-white no-underline transition hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          >
            {copy.cta}
            <span aria-hidden="true">→</span>
          </a>
          <a
            href="#featured"
            class="text-sm font-semibold text-foreground underline decoration-dashed underline-offset-4 hover:text-accent"
          >
            {copy.browse} ↓
          </a>
        </div>
        <p class="mt-3 text-xs text-foreground/60">{copy.ctaNote}</p>

        {
          SOCIALS.length > 0 && (
            <div class="mt-8 flex items-center gap-2 text-sm text-foreground/70">
              <span class="whitespace-nowrap">{copy.socials}</span>
              <Socials />
              <a
                target="_blank"
                href={withLang(lang, "rss.xml")}
                class="inline-block"
                aria-label="rss feed"
                title="RSS Feed"
              >
                <IconRss
                  width={18}
                  height={18}
                  class="stroke-accent stroke-3 rtl:-rotate-90"
                />
                <span class="sr-only">RSS Feed</span>
              </a>
            </div>
          )
        }
      </div>
    </section>

    <div class="app-layout">
    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-b border-border": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">Featured</h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">Recent Posts</h2>
          <ul>
            {recentPosts.map(
              (data, index) =>
                index < SITE.postPerIndex && <Card variant="h3" {...data} />
            )}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href={withLang(lang, "posts")}>
        {copy.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
