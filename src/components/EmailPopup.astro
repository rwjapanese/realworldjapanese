---
// Exit-intent / scroll-depth email popup for the free "Saying No 5" PDF.
// Rendered on article pages only (PostDetails.astro); renders nothing while
// NEWSLETTER_SUBSCRIBE_URL is empty, same safeguard as EmailCTA.astro.
// Frequency caps: once per browser session, 14 days after dismiss, 90 days
// after clicking through — stored in localStorage under "rwj-email-popup".
import { NEWSLETTER_SUBSCRIBE_URL } from "@/config/newsletter";

type Props = {
  lang?: string;
};

const copy = {
  ja: {
    eyebrow: "無料PDF",
    title: "断り方の実例PDF、受け取りませんか？",
    blurb:
      "職場で角が立たない「断り方」5場面を、NG例とA/B/Cレベル注釈つきで収録した英語解説PDF。登録メールアドレスに届きます。",
    cta: "無料PDFを受け取る",
    note: "無料・週1通・いつでも解除できます",
    close: "閉じる",
  },
  en: {
    eyebrow: "Free PDF",
    title: "Before you go — grab the free PDF",
    blurb:
      "Saying No in Japanese: 5 work situations, each with what NOT to say and casual / work-safe / formal versions. Sent straight to your inbox.",
    cta: "Get the free PDF",
    note: "Free · one work-safe phrase a week · unsubscribe anytime",
    close: "Close",
  },
};

const { lang = "ja" } = Astro.props;
const c = lang === "en" ? copy.en : copy.ja;
const href = NEWSLETTER_SUBSCRIBE_URL;
---

{
  href && (
    <div
      data-email-popup
      data-popup-lang={lang}
      class="fixed inset-0 z-50 hidden items-center justify-center p-4"
      role="dialog"
      aria-modal="true"
      aria-labelledby="email-popup-title"
    >
      <div data-popup-dismiss class="absolute inset-0 bg-black/50" />
      <div class="relative w-full max-w-md rounded-lg border border-accent/40 bg-background p-6 shadow-lg">
        <button
          type="button"
          data-popup-dismiss
          aria-label={c.close}
          class="absolute top-2.5 right-2.5 rounded-md p-1.5 text-xl leading-none text-foreground/60 transition hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          ×
        </button>
        <p class="mb-1 text-xs font-semibold tracking-wide text-accent uppercase">
          {c.eyebrow}
        </p>
        <p id="email-popup-title" class="mb-2 text-lg font-semibold text-foreground">
          {c.title}
        </p>
        <p class="mb-5 text-sm leading-relaxed text-foreground/80">{c.blurb}</p>
        <a
          href={href}
          target="_blank"
          rel="noopener"
          data-popup-link
          class="inline-flex items-center gap-2 rounded-md bg-accent px-5 py-2.5 text-sm font-semibold text-background no-underline transition hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          {c.cta}
          <span aria-hidden="true">→</span>
        </a>
        <p class="mt-3 text-xs text-foreground/60">{c.note}</p>
      </div>
    </div>
  )
}

<script>
  // Global listeners are registered once (module scripts run once even with
  // the ClientRouter); the popup element is re-queried at trigger time so view
  // transitions never leave us holding a detached node.
  const STORAGE_KEY = "rwj-email-popup";
  const SESSION_KEY = "rwj-email-popup-session";
  const DISMISS_DAYS = 14;
  const CLICK_DAYS = 90;
  const SCROLL_TRIGGER = 0.55; // fire once 55% of the page has been scrolled
  const MIN_TIME_ON_PAGE_MS = 10_000; // scroll trigger only; exit-intent fires anytime

  let pageLoadedAt = Date.now();

  function sendPopupEvent(name: string, params: Record<string, string>) {
    const gtag = (window as unknown as { gtag?: (...args: unknown[]) => void })
      .gtag;
    if (typeof gtag === "function") gtag("event", name, params);
  }

  function suppressedUntil(): number {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return 0;
      return JSON.parse(raw).until ?? 0;
    } catch {
      return 0;
    }
  }

  function suppress(days: number) {
    try {
      localStorage.setItem(
        STORAGE_KEY,
        JSON.stringify({ until: Date.now() + days * 86_400_000 })
      );
    } catch {
      /* private mode etc. — session cap still applies */
    }
  }

  function hide(popup: HTMLElement) {
    popup.classList.add("hidden");
    popup.classList.remove("flex");
  }

  function maybeShow(trigger: "exit" | "scroll") {
    if (sessionStorage.getItem(SESSION_KEY) === "1") return;
    if (Date.now() < suppressedUntil()) return;
    const popup = document.querySelector<HTMLElement>("[data-email-popup]");
    if (!popup) return;

    sessionStorage.setItem(SESSION_KEY, "1");
    const lang = popup.dataset.popupLang ?? "ja";
    popup.classList.remove("hidden");
    popup.classList.add("flex");
    sendPopupEvent("email_cta_view", { cta_type: "popup", lang, trigger });

    popup.querySelectorAll<HTMLElement>("[data-popup-dismiss]").forEach(el =>
      el.addEventListener(
        "click",
        () => {
          hide(popup);
          suppress(DISMISS_DAYS);
          sendPopupEvent("email_popup_dismiss", { lang });
        },
        { once: true }
      )
    );

    popup
      .querySelector<HTMLAnchorElement>("[data-popup-link]")
      ?.addEventListener("click", () => {
        suppress(CLICK_DAYS);
        sendPopupEvent("email_cta_click", { cta_type: "popup", lang });
        hide(popup);
      });

    document.addEventListener(
      "keydown",
      e => {
        if (e.key === "Escape" && !popup.classList.contains("hidden")) {
          hide(popup);
          suppress(DISMISS_DAYS);
          sendPopupEvent("email_popup_dismiss", { lang });
        }
      },
      { once: true }
    );

    popup.querySelector<HTMLAnchorElement>("[data-popup-link]")?.focus();
  }

  // Desktop exit intent: cursor leaves through the top of the viewport.
  document.addEventListener("mouseout", e => {
    if (e.clientY <= 0 && !e.relatedTarget) maybeShow("exit");
  });

  // Scroll depth (covers mobile, where mouseout never fires).
  document.addEventListener(
    "scroll",
    () => {
      if (Date.now() - pageLoadedAt < MIN_TIME_ON_PAGE_MS) return;
      const scrollable =
        document.documentElement.scrollHeight - window.innerHeight;
      if (scrollable <= 0) return;
      if (window.scrollY / scrollable >= SCROLL_TRIGGER) maybeShow("scroll");
    },
    { passive: true }
  );

  document.addEventListener("astro:page-load", () => {
    pageLoadedAt = Date.now();
  });
</script>
